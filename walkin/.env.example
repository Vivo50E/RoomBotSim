# copy to .env and fill in
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=qwen/qwen3.7-flash
BRAIN_MODEL=qwen/qwen3.7-flash
BRAIN_PERIOD_S=5

WORLDLABS_API_KEY=
WORLD_SOURCE=marble
MARBLE_MODEL=marble-1.1
MARBLE_CROSS_CHECK=1
MARBLE_CROSS_MODEL=marble-1.0-draft
MARBLE_MESH=0                       # 1 to also export the collider mesh; slow, see marble.fetch_scene
MARBLE_MESH_TIMEOUT_S=180

POLICY_KIND=scripted
POLICY_URL=https://openrouter.ai/api/v1/chat/completions
POLICY_MODEL=qwen/qwen3.7-flash
RECORD_FRAMES=0
